{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopPetAI",
  "version": "0.2.0",
  "identifier": "com.desktoppet.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Desktop Pet AI",
        "width": 420,
        "height": 640,
        "minWidth": 220,
        "minHeight": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true,
        "fullscreen": false,
        "center": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["TradChinese", "English"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sergeantsofa/desktop-pet-ai/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyQzRGQ0VENEM0OUQ5OEYKUldTUDJVbE03ZnpFb2lveUxBbmlsMTQyTGV1dHQxRy92TUo2VmpvRUI0V0M5MVM4cGd3aCs4bjUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
